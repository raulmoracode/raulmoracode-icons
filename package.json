{
  "name": "@raulmoracode/icons",
  "version": "1.0.0",
  "description": "Icon library for RaulMoraCode projects",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Apple": {
      "types": "./dist/icons/enterprise/Apple.d.ts",
      "import": "./dist/icons/enterprise/Apple.js"
    },
    "./Github": {
      "types": "./dist/icons/enterprise/Github.d.ts",
      "import": "./dist/icons/enterprise/Github.js"
    },
    "./Linux": {
      "types": "./dist/icons/so/Linux.d.ts",
      "import": "./dist/icons/so/Linux.js"
    },
    "./Windows": {
      "types": "./dist/icons/so/Windows.d.ts",
      "import": "./dist/icons/so/Windows.js"
    },
    "./Star": {
      "types": "./dist/icons/common/Star.d.ts",
      "import": "./dist/icons/common/Star.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "latest",
    "react": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
